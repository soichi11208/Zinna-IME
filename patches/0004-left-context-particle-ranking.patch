diff --git a/src/rewriter/context_particle_rewriter.cc b/src/rewriter/context_particle_rewriter.cc
new file mode 100644
index 000000000..8362fbd80
--- /dev/null
+++ b/src/rewriter/context_particle_rewriter.cc
@@ -0,0 +1,89 @@
+#include "rewriter/context_particle_rewriter.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+
+#include "absl/strings/string_view.h"
+#include "converter/segments.h"
+#include "request/conversion_request.h"
+
+namespace mozc {
+namespace {
+
+// The particles worth protecting: one- and two-mora function words that follow a noun and have
+// common homophones among content words. Longer or rarer ones are left alone — the point is to
+// settle a close call, not to force kana wherever it could appear.
+constexpr absl::string_view kParticles[] = {
+    "に", "を", "が", "へ", "で", "は", "も", "と", "から", "まで",
+    "には", "にも", "では", "でも", "とは", "への", "からの",
+};
+
+// How far down the list to look. A candidate the converter put below this is not losing a close
+// call, and dragging it to the front would be overruling the language model rather than informing
+// it.
+constexpr size_t kMaxRank = 5;
+
+bool StartsWithParticle(absl::string_view text) {
+  for (const absl::string_view particle : kParticles) {
+    if (text.size() > particle.size() && text.starts_with(particle)) {
+      return true;
+    }
+    if (text == particle) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Whether the phrase to the left is the kind of thing a particle attaches to.
+bool HistoryIsNoun(const Segments &segments,
+                   const dictionary::PosMatcher &pos_matcher) {
+  if (segments.history_segments_size() == 0) {
+    return false;
+  }
+  const Segment &history =
+      segments.history_segment(segments.history_segments_size() - 1);
+  if (history.candidates_size() == 0) {
+    return false;
+  }
+  const uint16_t rid = history.candidate(0).rid;
+  return pos_matcher.IsGeneralNoun(rid) || pos_matcher.IsUniqueNoun(rid) ||
+         pos_matcher.IsNumber(rid);
+}
+
+}  // namespace
+
+bool ContextParticleRewriter::Rewrite(const ConversionRequest &request,
+                                      Segments *segments) const {
+  if (segments == nullptr || segments->conversion_segments_size() == 0) {
+    return false;
+  }
+  if (!HistoryIsNoun(*segments, pos_matcher_)) {
+    return false;
+  }
+
+  Segment *segment = segments->mutable_conversion_segment(0);
+  if (segment->candidates_size() < 2) {
+    return false;
+  }
+  // Only phrases that are *read* as starting with a particle are candidates for this at all.
+  if (!StartsWithParticle(segment->candidate(0).key)) {
+    return false;
+  }
+  // Already right; nothing to settle.
+  if (StartsWithParticle(segment->candidate(0).value)) {
+    return false;
+  }
+
+  const size_t limit = std::min(kMaxRank, segment->candidates_size());
+  for (size_t i = 1; i < limit; ++i) {
+    if (StartsWithParticle(segment->candidate(i).value)) {
+      segment->move_candidate(static_cast<int>(i), 0);
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace mozc
diff --git a/src/rewriter/context_particle_rewriter.h b/src/rewriter/context_particle_rewriter.h
new file mode 100644
index 000000000..459644844
--- /dev/null
+++ b/src/rewriter/context_particle_rewriter.h
@@ -0,0 +1,46 @@
+// Prefers a particle reading over its homophones when the phrase follows a noun.
+
+#ifndef MOZC_REWRITER_CONTEXT_PARTICLE_REWRITER_H_
+#define MOZC_REWRITER_CONTEXT_PARTICLE_REWRITER_H_
+
+#include "converter/segments.h"
+#include "dictionary/pos_matcher.h"
+#include "request/conversion_request.h"
+#include "rewriter/rewriter_interface.h"
+
+namespace mozc {
+
+// Promotes a candidate that begins with a particle when the text to the left is a noun.
+//
+// Japanese conversion decides に after 東京 by segment connection cost, and that comparison is
+// only as good as the left context. A mobile input method usually has none: each phrase is
+// converted from a standing start, so a one-mora particle is ranked against homophones — 二, 荷,
+// 似 — that carry a better unigram cost on their own. 東京 に行きます comes out as 東京 二行きます,
+// 練習 なら as 練習 奈良, 追記 したい as 追記 死体.
+//
+// The client does know what was committed to the left, and mozc will reconstruct a history segment
+// from it (see converter/history_reconstructor.cc). This rewriter is what turns that knowledge
+// into an ordering: when the history segment is noun-like and the current phrase has a reading
+// that starts with a particle, the candidate that actually leaves the particle as kana is moved
+// ahead of the homophones.
+//
+// Deliberately conservative. It only promotes a candidate that the converter already ranked near
+// the top, so this settles a close call rather than inventing an answer, and it never runs without
+// a noun to the left.
+class ContextParticleRewriter : public RewriterInterface {
+ public:
+  explicit ContextParticleRewriter(const dictionary::PosMatcher &pos_matcher)
+      : pos_matcher_(pos_matcher) {}
+
+  int capability(const ConversionRequest &request) const override { return ALL; }
+
+  bool Rewrite(const ConversionRequest &request,
+               Segments *segments) const override;
+
+ private:
+  const dictionary::PosMatcher pos_matcher_;
+};
+
+}  // namespace mozc
+
+#endif  // MOZC_REWRITER_CONTEXT_PARTICLE_REWRITER_H_
