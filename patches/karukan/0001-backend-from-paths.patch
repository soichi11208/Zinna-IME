+
+    /// Create a backend from files that are already on disk.
+    ///
+    /// The registry constructors above reach HuggingFace to fill these two paths in. An input
+    /// method that ships its own model has them already, and on a platform where the process has
+    /// no network access at all the download path cannot run regardless.
+    pub fn from_paths(gguf_path: &str, tokenizer_json_path: &str) -> Self {
+        Backend {
+            gguf_path: gguf_path.to_string(),
+            tokenizer_json_path: tokenizer_json_path.to_string(),
+            display_name: "custom".to_string(),
+        }
+    }
