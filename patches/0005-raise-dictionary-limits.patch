-// Maximum file size (64Mbyte)
-constexpr size_t kMaxFileSize = 64 * 1024 * 1024;
+// Maximum file size.
+//
+// Raised from upstream's 64MB because the user dictionary now goes through this storage (see
+// dictionary/user_dictionary_storage.cc) and a bundled Wikipedia-derived dictionary is far larger
+// than anything a person would type by hand. Hitting the cap does not truncate — it refuses to
+// load the file at all — so the bound has to sit above the largest dictionary we ship.
+constexpr size_t kMaxFileSize = 512 * 1024 * 1024;
