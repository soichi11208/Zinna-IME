diff --git a/src/dictionary/user_dictionary_storage.cc b/src/dictionary/user_dictionary_storage.cc
--- a/src/dictionary/user_dictionary_storage.cc
+++ b/src/dictionary/user_dictionary_storage.cc
@@ -70,7 +70,11 @@
 
 // The limits of dictionary/entry size.
 constexpr size_t kMaxDictionarySize = 100;
-constexpr size_t kMaxEntrySize = 1000000;
+// Raised from upstream's 1,000,000. The bundled Wikipedia-derived dictionary alone is over a
+// million entries, and splitting it across dictionaries to fit would put an arbitrary seam through
+// one body of words for no reason the user could see. The limit is a sanity bound rather than a
+// structural one — nothing downstream indexes entries by a fixed-width type.
+constexpr size_t kMaxEntrySize = 4000000;
 
 // Default filename of user dictionary.
 constexpr absl::string_view kUserDictionaryFile = "user://user_dictionary.db";
